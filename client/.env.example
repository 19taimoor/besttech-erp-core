# Base URL of the backend API (no trailing slash). Must not be hardcoded to
# localhost in production builds - point this at the deployed API's origin.
VITE_API_URL=http://localhost:4000/api

# Dev-only convenience: prefills (does NOT bypass) the login form with the
# seeded admin credentials. Must default to false and stays inert in prod builds.
VITE_DEV_AUTO_LOGIN=false
